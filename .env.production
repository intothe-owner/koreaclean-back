# ========= Core =========
NODE_ENV=production
PORT=4500
BASEURL=http://113.131.151.103:4500

# ========= JWT / Auth =========
JWT_ACCESS_SECRET=change-this-access-secret
JWT_REFRESH_SECRET=change-this-refresh-secret
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=30d
ACCESS_TTL_SEC=3600
REMEMBER_TTL_SEC=1209600
AUTO_LOGIN_ENABLED=true

# ========= Cookies (Cross-site 배포 시) =========
COOKIE_CROSS_SITE=true           # 서버:4500, 프론트:3000 등 교차 도메인일 때 true
COOKIE_DOMAIN=.your-domain.com   # 운영 도메인 사용 시만 지정(예: .cleancoop.kr)
# sameSite/secure는 NODE_ENV, CROSS_SITE 여부에 따라 코드에서 자동 결정

# ========= CORS =========
# 쉼표로 구분된 허용 origin 목록
CORS_ORIGINS=http://localhost:3000,http://113.131.151.103:3000,http://113.131.151.103:8088,http://localhost:8088

